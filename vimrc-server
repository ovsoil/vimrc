" ============================================================================
" Simple vim config without any plugins
" Maintainer: ovsoil
"       hxyumail@gmail.com
" ============================================================================

" leader
let mapleader = "\<Space>"
let g:mapleader = "\<Space>"

" syntax
syntax on
filetype on
filetype plugin on
filetype indent on

" encoding
set encoding=utf-8
set fileencodings=ucs-bom,utf-8,cp936,gb18030,big5,euc-jp,euc-kr,latin1
set ffs=unix,dos,mac
set formatoptions+=mB

" base
set nocompatible
set autoread
set shortmess=atI
set magic
set title
set nobackup
set novisualbell
set noerrorbells
set visualbell t_vb=
set t_vb=
set tm=500
set history=2000

" ui
set cursorline
set scrolloff=7
set ruler
set number
set nowrap
set showcmd
set showmode
set showmatch
set matchtime=2
set laststatus=2
set background=dark
colorscheme desert

hi! link SignColumn   LineNr
hi! link ShowMarksHLl DiffAdd
hi! link ShowMarksHLu DiffChange

set statusline=%<%f\ %h%m%r%=%k[%{(&fenc==\"\")?&enc:&fenc}%{(&bomb?\",BOM\":\"\")}]\ %-14.(%l,%c%V%)\ %P

" search
set hlsearch
set incsearch
set ignorecase
set smartcase

" tab/indent
set expandtab
set smarttab
set shiftround
set autoindent
set smartindent
set shiftwidth=4
set tabstop=4
set softtabstop=4

" select & complete
set selection=inclusive
set completeopt=longest,menu
set wildmenu
set wildmode=longest,list,full
set wildignore=*.o,*~,*.pyc,*.class

" others
set backspace=indent,eol,start
set whichwrap+=<,>,h,l

" fold
set foldenable
set foldmethod=indent
set foldlevel=99
let g:FoldMethod = 0
map <leader>zz :call ToggleFold()<cr>
fun! ToggleFold()
    if g:FoldMethod == 0
        exe "normal! zM"
        let g:FoldMethod = 1
    else
        exe "normal! zR"
        let g:FoldMethod = 0
    endif
endfun

" grep
if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case
elseif executable('ag')
  set grepprg=ag\ --nogroup\ --nocolor
else
  set grepprg=grep\ -nrI\ --exclude-dir={CVS,'.bzr','.git','.hg','.svn'}
endif

" restore cursor position
if has("autocmd")
  au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
endif

au InsertLeave * set nopaste

" ============================ filetype ============================

autocmd FileType python set tabstop=4 shiftwidth=4 expandtab ai
autocmd FileType vim,json,yaml,javascript,html,xhtml,xml,css,vue,lua setlocal ts=2 sts=2 sw=2 expandtab
autocmd BufRead,BufNew *.md,*.mkd,*.markdown set filetype=markdown.mkd

autocmd FileType c,cpp,java,go,php,javascript,python,rust,xml,yml,perl autocmd BufWritePre <buffer> :call <SID>StripTrailingWhitespaces()
fun! <SID>StripTrailingWhitespaces()
    let l = line(".")
    let c = col(".")
    %s/\s\+$//e
    call cursor(l, c)
endfun

autocmd BufNewFile *.sh,*.py exec ":call AutoSetFileHead()"
function! AutoSetFileHead()
    if &filetype == 'sh'
        call setline(1, "\#!/bin/bash")
    endif
    if &filetype == 'python'
        call setline(1, "\#!/usr/bin/env python")
        call append(1, "\# encoding: utf-8")
    endif
    normal G
    normal o
    normal o
endfunc

" ============================ key map ============================

" movement
nnoremap k gk
nnoremap gk k
nnoremap j gj
nnoremap gj j
nnoremap H ^
nnoremap L $

" window
map <C-j> <C-W>j
map <C-k> <C-W>k
map <C-h> <C-W>h
map <C-l> <C-W>l

" toggle
nnoremap <F2> :set nu! nu?<CR>
nnoremap <F3> :set list! list?<CR>
nnoremap <F4> :set wrap! wrap?<CR>
set pastetoggle=<F5>
nnoremap <F6> :exec exists('syntax_on') ? 'syn off' : 'syn on'<CR>

" remap U to redo
nnoremap U <C-r>

" swap ' and `
nnoremap ' `
nnoremap ` '

" keep search at center
nnoremap <silent> n nzz
nnoremap <silent> N Nzz
nnoremap <silent> * *zz
nnoremap <silent> # #zz
nnoremap <silent> g* g*zz

" clear highlight
nnoremap <leader><cr> :nohl<cr>

" reselect after indent
vnoremap < <gv
vnoremap > >gv

" Y = y$
map Y y$

" ; to :
nnoremap ; :

" sudo save
cmap w!! w !sudo tee >/dev/null %

" command mode navigation
cnoremap <C-a> <Home>
cnoremap <C-e> <End>

" clipboard
nmap <leader>yy "+yy
vmap <leader>yy "+y
nmap <leader>pp "+p
vmap <leader>pp "+p
nmap <leader>pP "+P
vmap <leader>pP "+P
map <leader>p "0p

" trailing whitespace
func! DeleteTrailingWS()
  exe "normal mz"
  %s/\s\+$//ge
  exe "normal `z"
endfunc
nmap <leader>db :call DeleteTrailingWS()<cr>
nmap <leader>dm mmHmt:%s/<C-V><cr>//ge<cr>'tzt'm

" insert helpers
imap <silent> <C-D><C-D> <C-R>=strftime("%e %b %Y")<cr>
imap <silent> <C-T><C-T> <C-R>=strftime("%l:%M %p")<cr>
imap <silent> <C-C><C-C> <C-R>=string(eval(input("Calculate: ")))<cr>

" visual star search
let s:save_cpo = &cpo | set cpo&vim
if !exists('g:VeryLiteral')
  let g:VeryLiteral = 0
endif
function! s:VSetSearch(cmd)
  let old_reg = getreg('"')
  let old_regtype = getregtype('"')
  normal! gvy
  if @@ =~? '^[0-9a-z,_]*$' || @@ =~? '^[0-9a-z ,_]*$' && g:VeryLiteral
    let @/ = @@
  else
    let pat = escape(@@, a:cmd.'\')
    if g:VeryLiteral
      let pat = substitute(pat, '\n', '\\n', 'g')
    else
      let pat = substitute(pat, '^\_s\+', '\\s\\+', '')
      let pat = substitute(pat, '\_s\+$', '\\s\\*', '')
      let pat = substitute(pat, '\_s\+', '\\_s\\+', 'g')
    endif
    let @/ = '\V'.pat
  endif
  normal! gV
  call setreg('"', old_reg, old_regtype)
endfunction
vnoremap <silent> * :<C-U>call <SID>VSetSearch('/')<cr>/<C-R>/<cr>
vnoremap <silent> # :<C-U>call <SID>VSetSearch('?')<cr>?<C-R>/<cr>
let &cpo = s:save_cpo | unlet s:save_cpo

" highlight without jumping
nnoremap <leader>h :let @/='\<<C-R>=expand("<cword>")<cr>\>'<cr>:set hls<cr>
vnoremap <leader>h :<C-U>call <SID>VSetSearch('/')<cr>/<C-R>/<cr>N

" replace
vnoremap <leader>sr ""y:%s/<C-R>=escape(@", '/\')<cr>//gc<left><Left><Left>
nnoremap <leader>sr :%s/<C-R><C-W>//gc<left><left><left>

" grep word at cursor
nnoremap <leader>sw :grep! "\b<C-R><C-W>\b"<cr>:cw<cr>
vnoremap <leader>sw y:grep! '<C-R>"' .<cr>:cw<cr>

" yank/paste go to end
vnoremap <silent> y y`]
vnoremap <silent> p p`]
nnoremap <silent> p p`]
